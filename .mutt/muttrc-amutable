# muttrc-amutable -- configuration for <aleksa@amutable.com> with alias amutt.

set my_profile="amutable"
source $HOME/.mutt/muttrc
# TODO: aleksa@amutable.com doesn't have a PGP key yet...
#set pgp_default_key="C9C370B246B09F6DBCFC744C34401015D1D2D386"
set nocrypt_autosign
set nopgp_self_encrypt

set hostname="amutable.com"
set my_email="aleksa@$hostname"
set from=$my_email
set my_login=$my_email

# Change the major colour scheme to blue to differentiate it.
color status        color26         color232
color indicator     brightcolor26   default

# Configuration for inbox.
set folder="$my_mailroot/$my_profile"
set smtp_url="smtps://$my_login@smtp.gmail.com:465"
set spoolfile="+inbox"
set trash="+trash"
# TODO: These are probably broken...
set record="+sent"
set postponed="+drafts"

# I store my password information in KeePassXC (with a small wrapper so I can
# support different versions, as well as fix up some of the issues with
# KeePassXC's CLI interface).
set smtp_pass="`keepassxc-helper "/Shared/Email/Amutable"`"
